# Copy to .env.local for local runs, and set the same names in your host's environment settings.
ANTHROPIC_API_KEY=sk-ant-...        # required for the AI helpers. Never commit a real key.
# AI_MODEL=claude-opus-5-5           # optional; this is the default
# AI_ACCESS_CODE=                    # optional: if set, visitors must enter this code before the AI helpers work
# AI_RATE_PER_MIN=12                 # optional: requests per visitor per minute (default 12)
# AI_DAILY_LIMIT=400                 # optional: total requests per day per server instance (default 400)
# ALLOWED_ORIGINS=https://your-site.example   # optional: extra origins allowed to call /api/ai (same-origin is always allowed)
# AI_FALLBACK=off                    # optional: turn off server-side fallback on refusals
